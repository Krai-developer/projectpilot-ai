# ProjectPilot AI Configuration (Copy to .env)
APP_ENV=development
DATABASE_URL=sqlite:///./projectpilot.db
SECRET_KEY=change-this-in-production-use-64-hex-chars-minimum-non-secret-dev-default
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local Ollama AI Configuration (No Paid API Keys Required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=45

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
