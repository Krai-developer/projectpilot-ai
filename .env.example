# ProjectPilot AI Configuration (Copy to .env)
APP_ENV=development

# Database Configuration:
# Option A (Local Dev Default - SQLite):
DATABASE_URL=sqlite:///./projectpilot.db
# Option B (Cloud Production - Supabase PostgreSQL Session/Transaction Pooler URI):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

SECRET_KEY=change-this-in-production-use-64-hex-chars-minimum-non-secret-dev-default
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local Ollama AI Configuration (No Paid API Keys Required — falls back to deterministic engine when offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=coney_/llama3.1-claude-sonnet-4.6:latest
OLLAMA_TIMEOUT_SECONDS=45

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
